# backend/.env로 복사한 뒤 로컬 DB와 개발용 R2 값으로 바꿉니다.
# .env는 자동으로 읽히지 않습니다. 실행 전에 셸에서 source .env가 필요합니다.
SPRING_PROFILES_ACTIVE='local'
SERVER_ADDRESS='127.0.0.1'

DB_URL='jdbc:mysql://127.0.0.1:3306/blog_local?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8'
DB_USERNAME='blog_local'
DB_PASSWORD='replace-with-your-local-db-password'

# 운영 버킷과 분리된 개발용 버킷의 S3 호환 접속 정보입니다.
R2_ENDPOINT='https://replace-with-account-id.r2.cloudflarestorage.com'
R2_BUCKET='replace-with-development-bucket-name'
R2_REGION='auto'
R2_ACCESS_KEY_ID='replace-with-development-access-key-id'
R2_SECRET_ACCESS_KEY='replace-with-development-secret-access-key'

# 버킷의 공개 개발 URL 또는 사용자 지정 도메인입니다. S3 API 끝점과 다릅니다.
R2_PUBLIC_BASE_URL='https://pub-replace-with-development-bucket-id.r2.dev'

# 선택: Google 소셜 로그인. application-local.example.properties도 함께 설정합니다.
# GOOGLE_CLIENT_ID='replace-with-local-google-client-id'
# GOOGLE_CLIENT_SECRET='replace-with-local-google-client-secret'
